NODE_ENV=development
PORT=3000

# Either DATABASE_URL (as provided by Render) or the discrete DB_* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resale_os
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resale_os
DB_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-render-dashboard

# --- Actor Authority Model (Doc 03 §2 / Doc 04 §4) ---
# Single-User-App: statisches Bearer-Token statt Login-Flow (Doc 04
# definiert keinen /auth-Endpoint). Muss mit der id der einzigen Zeile in
# `users` übereinstimmen — die Migration 003_seed_single_user legt diese
# Zeile mit exakt der ID unten an, lokal wie auf Render.
APP_ACCESS_TOKEN=change-me
APP_USER_ID=00000000-0000-0000-0000-000000000000
# Für optionale interne HTTP-Aufrufe (Authorization: Bearer internal:<token>).
INTERNAL_SERVICE_TOKEN=change-me-internal

# --- Webhook-Signaturen (Doc 03 §12), pro Marktplatz ---
# Kleinanzeigen ist der einzige aktive Verkaufskanal (README §4e-Revision,
# September 2026) — kein WEBHOOK_SECRET_EBAY mehr nötig.
WEBHOOK_SECRET_KLEINANZEIGEN=change-me-kleinanzeigen-secret

# Debounce-Fenster für die SALE_CONFLICT-Auswertung (Doc 03 §9) in ms.
SALE_CONFLICT_DEBOUNCE_MS=15000

# LocalDiskStorageProvider (siehe dortige Doku: flüchtig auf Render, nur
# Dev/Demo). Relativ zu process.cwd() im Backend-Prozess. Greift nur, wenn
# S3_BUCKET unten NICHT gesetzt ist (siehe storage.module.ts).
UPLOAD_DIR=uploads

# --- Persistenter Fotospeicher (September 2026) ---
# Leer lassen für lokale Entwicklung (LocalDiskStorageProvider reicht
# dort). S3-kompatibel, nicht AWS-exklusiv — funktioniert z.B. mit
# Cloudflare R2 (S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com).
# S3_BUCKET=resale-os-photos
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://<dein-public-bucket-host>

# --- KI-Anbindung (Doc 01 §16, docs/README.md §9e) ---
# Ohne echten Schlüssel (oder mit dem Platzhalterwert unten) verwendet
# ProductAnalysisModule automatisch MockGeminiVisionProvider statt eines
# API-Calls, der garantiert scheitern würde — siehe dortige Doku.
GEMINI_API_KEY=unused-mock-provider-active
# Muss von RealGeminiVisionProvider aus erreichbar sein, um hochgeladene
# Fotos (relative /uploads/*-URLs) abzurufen.
PUBLIC_BASE_URL=http://localhost:3000
