# Platzhalter für die lokale Entwicklung. Kopieren nach backend/.env und
# die markierten Werte ersetzen. Keine echten Schlüssel in diese Datei.
#
# Welche Namen der laufende Prozess wirklich liest, steht am Zeilenende.
# Quelle: ConfigService.get / process.env in backend/src (Stand dieser Datei).

# --- Pflicht, vom Prozess gelesen ---

# Statisches Bearer-Token. ActorContextGuard vergleicht es mit
# Authorization: Bearer …. Gelesen.
APP_ACCESS_TOKEN=replace-with-a-long-random-token

# Muss die users-Zeile aus der Migration SeedSingleUser sein. Gelesen.
APP_USER_ID=00000000-0000-0000-0000-000000000000

# Render setzt das (render.yaml, generateValue). Der aktuelle Code liest
# JWT_SECRET nicht. Zugang läuft über APP_ACCESS_TOKEN. Trotzdem setzen,
# damit dasselbe Schema wie auf Render gilt.
JWT_SECRET=replace-with-a-long-random-secret

# Postgres. Entweder diese URL oder die DB_*-Zeilen weiter unten. Gelesen.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/resale_os

# BullMQ. Ohne Redis startet der Prozess nicht zuverlässig. Gelesen.
# Default im Code, wenn die Variable fehlt: redis://localhost:6379
REDIS_URL=redis://localhost:6380

# HTTP-Port. Default im Code: 3000. Gelesen. Der Prozess bindet 0.0.0.0.
PORT=3000

# production schaltet TypeORM-SQL-Logging aus. Gelesen.
NODE_ENV=development

# Absolute Basis für Foto-URLs (Gemini). Default im Code: http://localhost:3000. Gelesen.
PUBLIC_BASE_URL=http://localhost:3000

# Relativ zum Backend-Arbeitsverzeichnis, wenn kein S3_BUCKET gesetzt ist. Gelesen.
# Default im Code: uploads
UPLOAD_DIR=uploads

# Bearer-Token mit Präfix "internal:" für SYSTEM-Akteure. Gelesen.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token

# Signaturprüfung für marketplaceId "kleinanzeigen"
# (WebhookSignatureService liest WEBHOOK_SECRET_<MARKETPLACE>). Gelesen.
WEBHOOK_SECRET_KLEINANZEIGEN=replace-with-a-long-random-secret

# Verzögerung der Sale-Conflict-Auswertung in Millisekunden.
# Default im Code: 15000. Gelesen.
SALE_CONFLICT_DEBOUNCE_MS=15000

# --- Optional. Leer oder der Platzhalter lässt den Mock aktiv. Gelesen. ---
#
# GEMINI_API_KEY: echter Schlüssel schaltet Bildanalyse, Titel, Beschreibung,
# Preisrecherche, Ankaufsuche und Bildoptimierung scharf. Leer oder
# unused-mock-provider-active heißt: keine erfundenen Merkmale oder Preise.
# Anlegen: https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# EBAY_CLIENT_ID und EBAY_CLIENT_SECRET: beide nötig für die eBay Browse API
# (aktive Angebote, keine abgeschlossenen Verkäufe). Production App ID und
# Cert ID: https://developer.ebay.com/my/keys — Sandbox sieht den Markt nicht.
# Leer oder unused-mock-provider-active: keine erfundenen eBay-Preise.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
#
# S3_BUCKET schaltet den S3-Speicher ein (S3StorageProvider). Ohne Bucket
# schreibt die App nach UPLOAD_DIR. Die übrigen S3_*-Werte liest der
# S3-Provider, sobald ein Bucket gesetzt ist.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- Weitere Namen, die der Code liest, mit Default im Prozess ---

# Alternative zu DATABASE_URL. Nur ausgewertet, wenn DATABASE_URL fehlt.
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=resale
# DB_PASSWORD=replace-with-the-local-db-password
# DB_NAME=resale_os
# DB_SSL=false

# Sale-Conflict-Sweep. Defaults: Intervall 300000 ms, Gnadenfrist 300000 ms.
# SALE_CONFLICT_SWEEP_INTERVAL_MS=300000
# SALE_CONFLICT_SWEEP_GRACE_MS=300000

# Nur der Vite-Dev-Server (frontend/vite.config.ts), nicht das Nest-Image.
# VITE_API_PROXY_TARGET=http://localhost:3000
# Frontend-Client (frontend/src/api/client.ts). Leer heißt relativer Pfad /api.
# VITE_API_BASE_URL=
