NODE_ENV=development
PORT=3000

# Either DATABASE_URL (as provided by Render) or the discrete DB_* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resale_os
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resale_os
DB_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-render-dashboard

# --- Actor Authority Model (Doc 03 §2 / Doc 04 §4) ---
# Single-User-App: statisches Bearer-Token statt Login-Flow (Doc 04
# definiert keinen /auth-Endpoint). Muss mit der id der einzigen Zeile in
# `users` übereinstimmen (siehe README zum Seed-Schritt).
APP_ACCESS_TOKEN=change-me
APP_USER_ID=00000000-0000-0000-0000-000000000000
# Für optionale interne HTTP-Aufrufe (Authorization: Bearer internal:<token>).
INTERNAL_SERVICE_TOKEN=change-me-internal

# --- Webhook-Signaturen (Doc 03 §12), pro Marktplatz ---
WEBHOOK_SECRET_EBAY=change-me-ebay-secret
WEBHOOK_SECRET_KLEINANZEIGEN=change-me-kleinanzeigen-secret

# Debounce-Fenster für die SALE_CONFLICT-Auswertung (Doc 03 §9) in ms.
SALE_CONFLICT_DEBOUNCE_MS=15000

# LocalDiskStorageProvider (siehe dortige Doku: flüchtig auf Render, nur
# Dev/Demo). Relativ zu process.cwd() im Backend-Prozess.
UPLOAD_DIR=uploads
